<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Tenancy">
            <directory>tests/Tenancy</directory>
        </testsuite>
        <!--
            Feature tests served in campaign context, as opposed to the Tenancy
            suite's tests of the tenancy machinery itself. They sit outside the
            Feature suite because they provision real databases and so cannot use
            transactional RefreshDatabase, and they get their own suite to keep a
            sub-second feedback loop separate from the slower Tenancy suite.
        -->
        <testsuite name="Campaign">
            <directory>tests/Campaign</directory>
        </testsuite>
        <!--
            Tests driven through a real browser, which is why they are a suite
            of their own rather than more Campaign tests. They carry a
            precondition none of the four suites above has: built front-end
            assets and an installed Chromium. Folding them in would make a green
            Campaign run depend on an asset build, and the point of that suite
            is a sub-second loop.

            `artisan test` runs every suite, so CI picks this up with no second
            command, and anyone wanting the fast four can exclude it by name.
        -->
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
